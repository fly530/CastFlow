# ==============================================================================
# CastFlow Secret 範本
#
# ★ 副檔名刻意是 .yaml.example，不是 .yaml。
#   kubectl 只會讀取目錄下的 .yaml / .yml / .json，所以 `kubectl apply -f k8s/`
#   不會套用這個檔 —— 這是刻意的。
#
#   原因：先前這個檔以 .yaml 存在版控裡，帶著 "change-this-in-production-..."
#   這種可用的佔位值。伺服器只擋空字串，佔位值通得過，於是照 README 裝起來的
#   每一台 CastFlow，JWT 簽章金鑰都是這個公開 repo 裡的已知字串 —— 任何人都能
#   自己簽一個 admin token。看起來有做保護，實際上跟沒做一樣，比明顯沒做更危險。
#
#   現在伺服器會拒絕使用任何已知佔位值啟動（server/src/auth.js）。
#
# 用法：不要複製這個檔案去改，直接用指令生成，金鑰不會經過磁碟也不會進版控。
#
#   kubectl create namespace castflow
#   kubectl -n castflow create secret generic castflow-secrets \
#     --from-literal=jwt-secret="$(openssl rand -hex 32)" \
#     --from-literal=icecast-source-password="$(openssl rand -hex 16)" \
#     --from-literal=icecast-admin-password="$(openssl rand -hex 16)"
#
# 之後才執行：kubectl apply -k k8s/
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: castflow-secrets
  namespace: castflow
type: Opaque
stringData:
  # 管理員 JWT 簽章金鑰。產生：openssl rand -hex 32
  jwt-secret: ""

  # Icecast source 密碼。這把同時是 liquidsoap 推流用的密碼
  # （70-gateway.yaml 的 ICECAST_SOURCE_PASSWORD 指向同一個 key）。
  icecast-source-password: ""

  # Icecast 管理介面密碼。
  icecast-admin-password: ""

  # 註：不要加 icecast-password。libretime/icecast 不認 ICECAST_PASSWORD，
  # 給了也會被無聲丟棄，只會造成「以為設了其實沒設」的誤解。
