# ==========================================
# CastFlow 安全環境變數設定範本 (.env.example)
# ==========================================

# 1. JWT 管理員身分鑑權密鑰 (必須提供，伺服器拒絕在未設定時啟動)
# 產生指令: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_please_change_with_openssl_rand_hex_32

# 2. Icecast 廣播推流與管理密碼
# SOURCE 這把同時是 liquidsoap 推流時使用的密碼（兩邊必須是同一個值）。
# 注意 libretime/icecast 不認 ICECAST_PASSWORD，別再加回來。
ICECAST_SOURCE_PASSWORD=castflow_source_secure_password
ICECAST_ADMIN_PASSWORD=castflow_admin_secure_password
