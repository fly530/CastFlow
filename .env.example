# ==========================================
# CastFlow 安全環境變數設定範本 (.env.example)
# ==========================================

# 1. JWT 管理員身分鑑權密鑰 (必須提供，伺服器拒絕在未設定時啟動)
# 產生指令: openssl rand -hex 32
JWT_SECRET=

# 2. Icecast 廣播推流與管理密碼
# SOURCE 這把同時是 liquidsoap 推流時使用的密碼（兩邊必須是同一個值）。
# 注意 libretime/icecast 不認 ICECAST_PASSWORD，別再加回來。
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=

# 3. Traefik 路由用的網域（只有 compose.komodo.yaml 會用到，缺少時拒絕啟動）
CASTFLOW_HOST=radio.example.com

# 4. 主機上存放音樂/資料庫/備份的絕對路徑（只有 compose.komodo.yaml 會用到）
# 需先建好並交給 uid 1000：
#   sudo mkdir -p /var/lib/castflow/{music,data,backups} && sudo chown -R 1000:1000 /var/lib/castflow
CASTFLOW_DATA_DIR=/var/lib/castflow
