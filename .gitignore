# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
out/

# Runtime data & Local Storage
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
output/hls/*
!output/hls/.gitkeep

# Music directory (All user audio media & playlist subdirectories)
music/*
!music/.gitkeep

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary files
scratch/
tmp/
*.tmp
